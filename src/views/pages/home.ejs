<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="dark-theme">

  <%- include('../partials/header') %>

  <main class="auth-page-wrapper">
    <div class="hero-container">
      <div class="hero-badge">Civic Engagement & Municipal Transparency</div>
      <h1 class="hero-title">Fix Public Problems.<br><span class="brand-accent">Request New Facilities.</span></h1>
      <p class="hero-desc">
        CivicFix bridges the gap between residents and local government administration. Report existing infrastructure defects or request missing amenities in your ward.
      </p>

      <div class="hero-cta-grid">
        <a href="/register" class="hero-card cta-register">
          <div class="hero-card-icon">📝</div>
          <div class="hero-card-content">
            <h3>Citizen Registration</h3>
            <p>Create your verified citizen profile with your local municipality or gram panchayat.</p>
            <span class="card-action-link">Register Now &rarr;</span>
          </div>
        </a>

        <a href="/login" class="hero-card cta-login">
          <div class="hero-card-icon">🔐</div>
          <div class="hero-card-content">
            <h3>Citizen Login</h3>
            <p>Access your personal dashboard to track submitted issues and facility requests.</p>
            <span class="card-action-link">Sign In &rarr;</span>
          </div>
        </a>
      </div>

      <div class="civic-services-banner">
        <div class="service-chip">
          <span class="chip-dot dot-issue"></span>
          <strong>Service A:</strong> Issue Reports (Potholes, Broken Streetlights, Blocked Drains)
        </div>
        <div class="service-chip">
          <span class="chip-dot dot-facility"></span>
          <strong>Service B:</strong> Facility Requests (New Lighting, Bins, Public Drinking Water)
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>
