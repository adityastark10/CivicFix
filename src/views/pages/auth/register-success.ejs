<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body class="dark-theme">

  <%- include('../../partials/header') %>

  <main class="auth-page-wrapper">
    <div class="auth-card-container">
      
      <div class="success-icon-badge">✓</div>

      <div class="auth-card-header text-center">
        <h1 class="auth-title">Registration Successful</h1>
        <p class="auth-subtitle">Your citizen profile details have been verified and processed.</p>
      </div>

      <div class="summary-box">
        <div class="summary-row">
          <span class="summary-label">Full Name:</span>
          <span class="summary-value"><%= citizen.fullName %></span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Phone (Login ID):</span>
          <span class="summary-value">+91 <%= citizen.phoneNumber %></span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Email:</span>
          <span class="summary-value"><%= citizen.email %></span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Aadhaar (Preserved):</span>
          <span class="summary-value"><%= citizen.maskedAadhaar %></span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-row">
          <span class="summary-label">Jurisdiction:</span>
          <span class="summary-value"><%= citizen.localGovType %></span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Local Body:</span>
          <span class="summary-value"><%= citizen.localBodyName %></span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Ward / Locality:</span>
          <span class="summary-value"><%= citizen.wardNumber %>, <%= citizen.locality %></span>
        </div>
        <div class="summary-row">
          <span class="summary-label">District & State:</span>
          <span class="summary-value"><%= citizen.district %>, <%= citizen.state %> - <%= citizen.pinCode %></span>
        </div>
      </div>

      <div class="form-actions mt-6">
        <a href="/login" class="btn-primary-action text-center block">
          Proceed to Login
        </a>
      </div>

    </div>
  </main>

  <%- include('../../partials/footer') %>

</body>
</html>
