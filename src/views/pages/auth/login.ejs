<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body class="dark-theme">

  <%- include('../../partials/header') %>

  <main class="auth-page-wrapper">
    <div class="auth-card-container auth-card-compact">
      
      <!-- Card Header -->
      <div class="auth-card-header">
        <h1 class="auth-title">Citizen Login</h1>
        <p class="auth-subtitle">Sign in to track your reported issues and facility requests.</p>
      </div>

      <!-- General Form Message / Error -->
      <% if (typeof errors !== 'undefined' && errors.general) { %>
        <div class="alert-banner alert-info" role="alert">
          <span class="alert-icon">ℹ️</span>
          <span><%= errors.general %></span>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/login" method="POST" id="loginForm" class="auth-form" novalidate>

        <!-- 1. Phone Number -->
        <div class="form-group">
          <label for="phoneNumber" class="form-label">Phone Number <span class="required-star">*</span></label>
          <div class="input-with-prefix">
            <span class="input-prefix">+91</span>
            <input 
              type="tel" 
              id="phoneNumber" 
              name="phoneNumber" 
              maxlength="10"
              class="form-input input-prefixed <%= errors && errors.phoneNumber ? 'input-error' : '' %>"
              placeholder="10-digit mobile number"
              value="<%= typeof formData !== 'undefined' && formData.phoneNumber ? formData.phoneNumber : '' %>"
              required
              autocomplete="username"
            />
          </div>
          <span class="field-error-msg" id="phoneNumberError"><%= errors && errors.phoneNumber ? errors.phoneNumber : '' %></span>
        </div>

        <!-- 2. Password -->
        <div class="form-group">
          <label for="password" class="form-label">Password <span class="required-star">*</span></label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-input <%= errors && errors.password ? 'input-error' : '' %>"
            placeholder="Enter your password"
            required
            autocomplete="current-password"
          />
          <span class="field-error-msg" id="passwordError"><%= errors && errors.password ? errors.password : '' %></span>
        </div>

        <!-- Single Primary Action Button -->
        <div class="form-actions">
          <button type="submit" class="btn-primary-action">
            Log In
          </button>
        </div>

        <!-- Bottom Link to Register -->
        <div class="auth-card-footer">
          <p>Don't have an account yet? <a href="/register" class="link-accent">Register here</a></p>
        </div>

      </form>

    </div>
  </main>

  <%- include('../../partials/footer') %>

</body>
</html>
